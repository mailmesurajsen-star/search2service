# Search2Service — nginx reverse proxy config
#
# Copy to /etc/nginx/sites-available/search2service, then:
#   sudo ln -s /etc/nginx/sites-available/search2service /etc/nginx/sites-enabled/
#   sudo nginx -t && sudo systemctl reload nginx
#
# Afterwards, get a free SSL cert (this rewrites the file to add the https block):
#   sudo certbot --nginx -d yourdomain.com -d www.yourdomain.com

server {
    listen 80;
    listen [::]:80;
    server_name yourdomain.com www.yourdomain.com;

    client_max_body_size 12m;  # a bit above the app's own 10MB upload limit

    location / {
        proxy_pass http://127.0.0.1:3000;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}
