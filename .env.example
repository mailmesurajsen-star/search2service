# Copy this file to .env.local (for `npm run dev`) or .env (for production) and fill in real values.
# Both the Next.js frontend and the FastAPI backend read from this same file.

# ---------------------------------------------------------
# REQUIRED
# ---------------------------------------------------------

# Internal URL the Next.js server uses to proxy /api/* requests to the FastAPI backend.
# Same-server deploy: keep this pointed at the backend's local port (not a public URL).
BACKEND_URL=http://127.0.0.1:8000

# Secret used to sign login JWTs. MUST be set to a long random value in production —
# the app refuses to start in production without it. Generate one with:
#   openssl rand -hex 32
JWT_SECRET=

# development | production — controls secure cookies, uvicorn auto-reload, and the
# JWT_SECRET check above. Set to "production" on the VPS.
ENVIRONMENT=production

# ---------------------------------------------------------
# DATABASE (backend) — SQLite by default, no server needed.
# ---------------------------------------------------------
DB_ENGINE=sqlite
SQLITE_PATH=./backend/data/search2service.db

# Only used when DB_ENGINE=mysql:
# MYSQL_HOST=localhost
# MYSQL_PORT=3306
# MYSQL_USER=root
# MYSQL_PASSWORD=
# MYSQL_DATABASE=search2service

# ---------------------------------------------------------
# OPTIONAL
# ---------------------------------------------------------

# Comma-separated list of allowed origins for the backend's CORS policy and the
# frontend's CORS response header. Defaults to "*" if unset. Tighten this to your
# real domain(s) in production, e.g. https://yourdomain.com
CORS_ORIGINS=*

# Backend bind address/port (defaults shown). Usually leave as-is; the reverse proxy
# (nginx) is what's actually exposed publicly.
HOST=0.0.0.0
PORT=8000

# AI Concierge chat (optional) — leave blank to disable; the app falls back to a
# non-AI keyword search response when this is empty.
EMERGENT_LLM_KEY=
GEMINI_MODEL=gemini-2.5-flash
